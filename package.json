{
  "name": "react-dex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace packages/shared && npm run build --workspace apps/api && npm run build --workspace apps/web",
    "build:web": "npm run build --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "seed:db": "tsx scripts/seed-db.ts",
    "typecheck": "npm run typecheck --workspaces",
    "test:unit": "npm run test --workspace apps/web",
    "test:e2e": "playwright test",
    "test": "echo 'No root tests configured'"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@playwright/test": "^1.49.1",
    "csv-parse": "^5.6.0",
    "pg": "^8.12.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0"
  }
}
